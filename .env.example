# Server
PORT=3000
NODE_ENV=development

# Auth
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_long_random_secret
GOOGLE_CLIENT_ID=replace_with_your_google_client_id

# Database (strongly recommended for production/Vercel)
# Without this, local dev uses data/*.json and serverless deployments use
# ephemeral in-memory storage.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kamiwear

# Payments
# Cash on Delivery and UPI are always enabled.
# Add Razorpay keys to enable real card payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Sandbox card simulation (development only — never enable in production)
ENABLE_BANKING_SIM=false

# Loyalty: 1 KamiKoin per ₹N spent
LOYALTY_EARN_RATE=10
