# ---------------------------------------------------------------- Server
PORT=3000
NODE_ENV=development
STORE_URL=https://kamiwear.vercel.app

# ---------------------------------------------------------------- Auth
# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
# Leave false for browser sessions (httpOnly cookie). Enable only for trusted API clients.
AUTH_RETURN_TOKEN=false
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------- Database
# Required for durable production data and multi-device session control.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kamiwear
MONGO_MAX_POOL_SIZE=50
# Set true to refuse traffic when MONGO_URI is missing (recommended in production)
REQUIRE_MONGO=false

# ---------------------------------------------------------------- Security
# Comma-separated extra origins allowed to call the API from a browser.
ALLOWED_ORIGINS=https://kamiwear.vercel.app,https://kamiwear-j2b9.vercel.app
# Optional shared rate-limit store (recommended for multi-instance deployments)
RATE_LIMIT_REDIS_URL=
# Required to use PATCH /api/orders/:id/verify-payment (min 16 chars)
ADMIN_API_KEY=

# ---------------------------------------------------------------- Payments
# Only Cash on Delivery and UPI are accepted.
UPI_ID=9253395564@ybl
UPI_PAYEE_NAME=Kamiwear

# ---------------------------------------------------------------- Email
# Preferred: Resend (works over HTTPS on Vercel). Verify your sender domain.
RESEND_API_KEY=
# Alternative: SMTP (some hosts block outbound SMTP ports)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_SEND_TIMEOUT_MS=10000
KAMIWEAR_SUPPORT_EMAIL=orders@kamiwear.in
KAMIWEAR_EMAIL_FROM=Kamiwear Orders <orders@kamiwear.in>

# ---------------------------------------------------------------- Loyalty
# 1 KamiKoin per ₹N spent
LOYALTY_EARN_RATE=10
